// Windows resources of arenile-desktop.exe: icon, version info, manifest.
// scripts/desktop/package-windows.sh fills the @PLACEHOLDERS@ and compiles
// it with MinGW windres into a temporary .syso next to cmd/arenile-desktop
// (the Go linker picks it up), deleted after the build.
#include <winver.h>

1 ICON "@ICON@"
// IDI_APPLICATION (32512): webview_go loads it as the icon of the panel
// window (title bar, taskbar, Alt+Tab).
32512 ICON "@ICON@"
1 24 "@MANIFEST@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @V_COMMA@,0
PRODUCTVERSION  @V_COMMA@,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041004B0"
        BEGIN
            VALUE "CompanyName",      "Coste360 SRL"
            VALUE "FileDescription",  "Arenile - gestionale per stabilimenti balneari"
            VALUE "FileVersion",      "@V_DOT@.0"
            VALUE "InternalName",     "arenile-desktop"
            VALUE "LegalCopyright",   "Arenile - Coste360.it, (c) Coste360 SRL - BSL 1.1 (BUSL-1.1)"
            VALUE "OriginalFilename", "arenile-desktop.exe"
            VALUE "ProductName",      "Arenile"
            VALUE "ProductVersion",   "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0410, 1200
    END
END
