{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@arenile/shared/*": [
        "../web/shared/src/*"
      ],
      "lucide-react": [
        "../web/node_modules/lucide-react"
      ],
      "~/*": [
        "./src/*"
      ]
    }
  }
}
