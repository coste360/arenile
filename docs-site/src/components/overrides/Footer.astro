---
// Starlight footer plus the product line: brand lockup "Arenile — Coste360.it"
// with the Coste360 logo (primary in light, white in dark), maintainer, licence
// (source available, BSL 1.1, never "open source") and the release the docs describe.
import Default from '@astrojs/starlight/components/Footer.astro';

const version = import.meta.env.ARENILE_DOCS_VERSION || process.env.ARENILE_DOCS_VERSION || '';
const brand = (file: string) => `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}brand/${file}`;
---

<Default />
<div class="arenile-footer">
  <p class="arenile-footer-brand">
    <a href="https://arenile.app">Arenile</a>
    <span aria-hidden="true">—</span>
    <a href="https://www.coste360.it/" class="arenile-footer-logo">
      <img
        src={brand('coste360-logo-primary.png')}
        alt="Coste360.it"
        width="120"
        height="48"
        class="dark:sl-hidden"
      />
      <img
        src={brand('coste360-logo-white.png')}
        alt="Coste360.it"
        width="120"
        height="48"
        class="light:sl-hidden"
      />
    </a>
  </p>
  <p>
    {Astro.locals.t('arenile.footer.product')}
    {version && <span> · {Astro.locals.t('arenile.footer.version', { version })}</span>}
  </p>
</div>

<style>
  .arenile-footer {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    text-align: center;
  }
  .arenile-footer-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .arenile-footer-brand a {
    color: inherit;
    text-decoration: none;
  }
  .arenile-footer-brand a:hover {
    text-decoration: underline;
  }
  .arenile-footer-logo {
    display: inline-flex;
  }
  .arenile-footer-logo img {
    height: 1.5rem;
    width: auto;
  }
</style>
