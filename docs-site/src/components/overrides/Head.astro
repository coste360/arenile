---
/**
 * Starlight's Head plus the structured data of the home pages (frontmatter
 * `home`): a schema.org SoftwareApplication (free, Web/Windows/macOS/Linux,
 * published by Coste360 SRL). The FAQPage data is emitted by <Faq> next to the
 * visible questions, so text and markup cannot drift apart.
 */
import Default from '@astrojs/starlight/components/Head.astro';

const route = Astro.locals.starlightRoute;
const data = route.entry.data;
const site = Astro.site ?? new URL(Astro.url.origin);
const abs = (path: string) => new URL(`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${path}`, site).href;

const jsonLd = data.home
  ? {
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'Arenile',
      url: new URL(Astro.url.pathname, site).href,
      description: data.description,
      inLanguage: route.lang,
      applicationCategory: 'BusinessApplication',
      applicationSubCategory: route.lang === 'it' ? 'Gestionale per stabilimenti balneari' : 'Beach club management',
      operatingSystem: 'Web, Windows, macOS, Linux',
      image: abs('og.png'),
      screenshot: abs('og.png'),
      license: 'https://spdx.org/licenses/BUSL-1.1.html',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
      publisher: {
        '@type': 'Organization',
        name: 'Coste360 SRL',
        url: 'https://www.coste360.it/',
        logo: abs('brand/coste360-logo-primary.png'),
      },
    }
  : null;
---

<Default />
{jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
