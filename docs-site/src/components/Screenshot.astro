---
/**
 * <Screenshot name="admin-map" alt="..." caption="..." />
 *
 * Shows the screenshot `name` (screenshots.manifest.json) in the theme the
 * reader picked in Starlight: both variants are emitted, CSS shows the one
 * matching <html data-theme>, and the hidden one is never downloaded
 * (loading="lazy" + display:none). Click (or Enter) opens it full size in a
 * native <dialog>. Desktop captures get a minimal browser frame showing the
 * route, mobile captures a phone frame.
 *
 * Unknown names fail the build; a name that was not captured yet renders a
 * placeholder (and fails the build with ARENILE_DOCS_STRICT=1).
 */
import { Image, getImage } from 'astro:assets';
import { STRICT, resolveScreenshot, type Theme } from '../lib/screenshots';

interface Props {
  /** Name from screenshots.manifest.json. */
  name: string;
  /** Text alternative (required: describe what the reader should notice). */
  alt: string;
  /** Optional caption under the image (Markdown is not parsed). */
  caption?: string;
  /** Hide the browser/phone frame. */
  frameless?: boolean;
  /** Above the fold (home hero): load eagerly instead of lazily. */
  eager?: boolean;
  /** Override the `sizes` hint when the layout shows the image narrower. */
  sizes?: string;
}

const { name, alt, caption, frameless = false, eager = false, sizes: sizesProp } = Astro.props;
if (!alt?.trim()) throw new Error(`<Screenshot name="${name}">: the alt text is required`);

const shot = resolveScreenshot(name);
const mobile = shot.viewport === 'mobile';
const themes = (['light', 'dark'] as Theme[]).filter((t) => shot.images[t]);
if (themes.length === 0 && STRICT) {
  throw new Error(`<Screenshot name="${name}">: no image in src/assets/screenshots/. Run make docs-screenshots.`);
}
if (themes.length === 1 && STRICT) {
  throw new Error(`<Screenshot name="${name}">: only the ${themes[0]} variant exists. Run make docs-screenshots.`);
}

const widths = mobile ? [390, 780] : [720, 1080, 1440];
const sizes = sizesProp ?? (mobile ? '(max-width: 40rem) 80vw, 22rem' : '(max-width: 50rem) 100vw, 46rem');
const full = Object.fromEntries(
  await Promise.all(
    themes.map(async (t) => [t, (await getImage({ src: shot.images[t]!, format: 'webp', quality: 85 })).src]),
  ),
) as Partial<Record<Theme, string>>;

/** The route as a reader would see it in the address bar, placeholders elided. */
const displayRoute = shot.route.replace(/\{[a-zA-Z]+\}/g, (p) => (p === '{slug}' ? 'lido-demo' : p === '{date}' ? '2027-05-10' : '…'));
const t = Astro.locals.t;
---

<figure class:list={['arenile-shot', 'not-content', mobile ? 'is-mobile' : 'is-desktop', { frameless }]} data-shot={name}>
  {
    themes.length === 0 ? (
      <div class="shot-missing" role="img" aria-label={alt}>
        <strong>{t('arenile.screenshot.missing')}</strong>
        <code>{name}</code>
        <span>{t('arenile.screenshot.missingHint')}</span>
      </div>
    ) : (
      <div class="shot-frame">
        {!mobile && !frameless && (
          <div class="shot-bar" aria-hidden="true">
            <span class="dot" />
            <span class="dot" />
            <span class="dot" />
            <span class="url">{displayRoute}</span>
          </div>
        )}
        <button
          type="button"
          class="shot-zoom"
          data-shot-zoom
          data-full-light={full.light ?? full.dark}
          data-full-dark={full.dark ?? full.light}
          aria-label={`${t('arenile.screenshot.zoom')}: ${alt}`}
        >
          {themes.map((theme) => (
            <Image
              src={shot.images[theme]!}
              alt={alt}
              widths={widths}
              sizes={sizes}
              format="webp"
              quality={82}
              loading={eager ? 'eager' : 'lazy'}
              decoding="async"
              class:list={['shot-img', themes.length === 2 && `only-${theme}`]}
            />
          ))}
        </button>
      </div>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  /** One shared native <dialog> for every screenshot of the page. */
  function dialog(): HTMLDialogElement {
    let d = document.querySelector<HTMLDialogElement>('dialog.arenile-shot-dialog');
    if (d) return d;
    d = document.createElement('dialog');
    d.className = 'arenile-shot-dialog';
    const img = document.createElement('img');
    img.decoding = 'async';
    d.append(img);
    // Click anywhere (image or backdrop) closes; Escape is native.
    d.addEventListener('click', () => d!.close());
    d.addEventListener('close', () => {
      img.removeAttribute('src');
      (d as HTMLDialogElement & { opener?: HTMLElement }).opener?.focus();
    });
    document.body.append(d);
    return d;
  }

  function open(button: HTMLButtonElement) {
    const dark = document.documentElement.dataset.theme === 'dark';
    const src = dark ? button.dataset.fullDark : button.dataset.fullLight;
    if (!src) return;
    const d = dialog() as HTMLDialogElement & { opener?: HTMLElement };
    const img = d.querySelector('img')!;
    img.src = src;
    img.alt = button.querySelector('img')?.alt ?? '';
    d.opener = button;
    d.showModal();
  }

  document.addEventListener('click', (event) => {
    const button = (event.target as Element | null)?.closest<HTMLButtonElement>('[data-shot-zoom]');
    if (button) open(button);
  });
</script>

<style>
  .arenile-shot {
    margin-block: 1.5rem;
  }
  .arenile-shot.is-mobile {
    max-width: 22rem;
    margin-inline: auto;
  }
  .shot-frame {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) + 2px);
    background: var(--card);
    box-shadow:
      0 1px 2px color-mix(in oklab, var(--foreground) 6%, transparent),
      0 12px 32px -12px color-mix(in oklab, var(--foreground) 18%, transparent);
  }
  /* Phone: a bezel with padding, so the screen keeps its own rounded corners
     and the capture's edges are never clipped by the outer radius. */
  .is-mobile .shot-frame {
    padding: 0.625rem;
    border-width: 1px;
    border-color: color-mix(in oklab, var(--foreground) 70%, var(--background));
    border-radius: 2.5rem;
    background: color-mix(in oklab, var(--foreground) 88%, var(--background));
  }
  .is-mobile:not(.frameless) .shot-img {
    border-radius: 1.875rem;
  }
  .frameless .shot-frame {
    border-radius: var(--radius);
  }
  .is-mobile.frameless .shot-frame {
    padding: 0;
    border-width: 1px;
    border-color: var(--border);
    background: var(--card);
  }
  .shot-bar {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--border);
    background: var(--muted);
  }
  .shot-bar .dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--muted-foreground) 45%, transparent);
  }
  .shot-bar .url {
    flex: 1;
    margin-inline-start: 0.75rem;
    padding: 0.125rem 0.75rem;
    overflow: hidden;
    border-radius: 999px;
    background: var(--background);
    color: var(--muted-foreground);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .shot-zoom {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .shot-zoom:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: -2px;
  }
  .shot-img {
    display: block;
    width: 100%;
    height: auto;
  }
  :global(:root[data-theme='dark']) .only-light,
  :global(:root:not([data-theme='dark'])) .only-dark {
    display: none;
  }
  figcaption {
    margin-top: 0.625rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    text-align: center;
  }
  .shot-missing {
    display: grid;
    gap: 0.25rem;
    place-items: center;
    padding: 2.5rem 1rem;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    background: var(--muted);
    color: var(--muted-foreground);
    font-size: var(--sl-text-sm);
    text-align: center;
  }
  .is-mobile .shot-missing {
    aspect-ratio: 390 / 844;
  }
  :global(dialog.arenile-shot-dialog) {
    max-width: min(96vw, 1600px);
    max-height: 94vh;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    cursor: zoom-out;
  }
  :global(dialog.arenile-shot-dialog::backdrop) {
    background: color-mix(in oklab, black 72%, transparent);
    backdrop-filter: blur(2px);
  }
  :global(dialog.arenile-shot-dialog img) {
    display: block;
    max-width: 100%;
    max-height: 94vh;
    width: auto;
    height: auto;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(dialog.arenile-shot-dialog[open]) {
      animation: arenile-shot-in 160ms ease-out;
    }
  }
  @keyframes arenile-shot-in {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
  }
</style>
