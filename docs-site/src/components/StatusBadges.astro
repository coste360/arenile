---
/**
 * <StatusBadges /> — the status badges of web/shared (StatusBadge with the
 * map palette), labelled with the shared translations. Static HTML, no JS.
 *
 * Props: statuses (subset and order; default: every spot status),
 *        descriptions (status -> short text shown next to the badge).
 */
import { StatusBadge } from '@arenile/shared/ui/patterns/StatusBadge';
import { SPOT_STATUSES, type SpotStatus } from '@arenile/shared/map/types';
import { map as enMap } from '@arenile/shared/i18n/locales/en.json';
import { map as itMap } from '@arenile/shared/i18n/locales/it.json';
import { docsLocale } from './islands/i18n';

interface Props {
  statuses?: SpotStatus[];
  descriptions?: Partial<Record<SpotStatus, string>>;
}

const { statuses = [...SPOT_STATUSES], descriptions } = Astro.props;
const locale = docsLocale(Astro.currentLocale ?? Astro.locals.starlightRoute?.lang);
const names = (locale === 'en' ? enMap : itMap).status as Record<SpotStatus, string>;
const withText = !!descriptions && Object.keys(descriptions).length > 0;
---

<div class="not-content arenile-island arenile-badges">
  {
    withText ? (
      <dl class="grid gap-x-4 gap-y-2 sm:grid-cols-[auto_1fr]">
        {statuses.map((s) => (
          <>
            <dt>
              <StatusBadge spotStatus={s}>{names[s]}</StatusBadge>
            </dt>
            <dd class="text-sm text-muted-foreground">{descriptions?.[s] ?? ''}</dd>
          </>
        ))}
      </dl>
    ) : (
      <ul class="flex flex-wrap gap-2" aria-label={Astro.locals.t('arenile.badges.label')}>
        {statuses.map((s) => (
          <li>
            <StatusBadge spotStatus={s}>{names[s]}</StatusBadge>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .arenile-badges {
    margin-block: 1rem;
  }
</style>
