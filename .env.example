# Arenile — variabili d'ambiente (spec 24.4).
# Copia questo file in .env nella radice del repository e personalizza i valori:
#   cp .env.example .env
# Non versionare mai .env.

# Indirizzo di ascolto del server HTTP.
ARENILE_ADDR=:8080

# URL pubblico dello stabilimento, obbligatorio in produzione
# (usato nei link delle email, nel widget incorporabile e nei redirect dei pagamenti).
ARENILE_BASE_URL=https://prenota.mio-lido.it

# Cartella dei dati: database SQLite, file caricati, backup.
ARENILE_DATA_DIR=/data

# Lascia vuoto per usare SQLite. Se valorizzato con postgres://, usa PostgreSQL.
# Esempio: postgres://arenile:password@postgres:5432/arenile?sslmode=disable
# Caratteri speciali nella password (@ : / # ? + =) vanno codificati (%40 ...).
DATABASE_URL=

# Chiave di cifratura: 32 byte in base64. Generala con: openssl rand -base64 32
# In sviluppo, se assente, viene generata e mostrata al primo avvio.
# Conservala con cura: senza questa chiave i dati cifrati non sono recuperabili.
ARENILE_SECRET_KEY=

# Esegue automaticamente le migrazioni del database all'avvio.
ARENILE_AUTO_MIGRATE=true

# Domini (separati da virgola) per i certificati TLS automatici (Let's Encrypt).
# Lascia vuoto se c'e' gia' un reverse proxy (Caddy, Traefik, Coolify, CapRover).
ARENILE_TLS_AUTOCERT_DOMAINS=

# Server SMTP per le email transazionali, es. smtp://utente:password@smtp.example.com:587
ARENILE_SMTP_URL=

# Mittente delle email, es. "Lido Esempio <prenotazioni@mio-lido.it>"
ARENILE_MAIL_FROM=

# Senza SMTP: cartella dove scrivere le email come file .eml (sviluppo, test end-to-end).
# Vuota = le email sono solo annotate nel log, con il destinatario mascherato.
ARENILE_MAIL_DIR=

# Solo per i test: indirizzo di un doppio dell'API Stripe (stripe-mock, finto Stripe e2e).
# Vuota = https://api.stripe.com. Non impostarla in produzione.
ARENILE_STRIPE_API_URL=

# Durata del blocco temporaneo (hold) di una postazione durante il checkout.
ARENILE_HOLD_TTL=10m

# Limiti per indirizzo IP dell'API pubblica (spec 17.2): letture e prenotazioni avviate al minuto.
# Alzali se molti clienti prenotano dalla stessa rete (Wi-Fi dell'hotel o del lido).
ARENILE_PUBLIC_READS_PER_MINUTE=60
ARENILE_PUBLIC_CREATIONS_PER_MINUTE=10

# Livello di log: debug, info, warn, error.
ARENILE_LOG_LEVEL=info

# CIDR dei proxy fidati (separati da virgola) da cui leggere l'IP reale del client.
ARENILE_TRUSTED_PROXIES=

# Rende obbligatoria l'autenticazione a due fattori (TOTP) per gli utenti owner.
ARENILE_REQUIRE_TOTP_FOR_OWNERS=false

# Nessuna telemetria di default.
ARENILE_TELEMETRY=false
# Avviso di nuova versione nel pannello (ADR 0025): una richiesta al giorno al
# file pubblico dell'ultima versione, con solo versione, edizione e sistema
# nell'User-Agent (non è telemetria). false = nessuna chiamata di rete.
ARENILE_UPDATE_CHECK=true
# File letto dal controllo (vuoto = https://updates.coste360.it/arenile/latest.json).
ARENILE_UPDATE_URL=
# Solo per un'istanza dimostrativa: il pulsante "Prova la demo" dell'app mobile
# (POST /api/device/v1/demo-pairing) abbina il telefono a questo utente di questo
# stabilimento, con il suo ruolo. Entrambe o nessuna; vuote = endpoint disattivato (404).
# Con i dati di `arenile seed demo`: cassa@lido-demo.example e lido-demo.
ARENILE_DEMO_PAIRING_USER=
ARENILE_DEMO_PAIRING_ESTABLISHMENT=
# Modalità sviluppo (come `arenile serve --dev`): genera una chiave segreta se
# assente. Mai in produzione.
ARENILE_DEV=false

# Primo utente owner, creato all'avvio di `serve` solo se il database non ha
# ancora utenti (l'immagine Docker è distroless e non ha una shell per
# `arenile admin create`). Servono tutte e quattro; ai riavvii successivi sono
# ignorate. La password (almeno 10 caratteri) può essere rimossa dopo il primo accesso.
ARENILE_BOOTSTRAP_OWNER_EMAIL=
ARENILE_BOOTSTRAP_OWNER_NAME=
ARENILE_BOOTSTRAP_OWNER_ORG=
ARENILE_ADMIN_PASSWORD=

# --- Solo per docker compose (deploy/) ---------------------------------------

# Versione dell'immagine ghcr.io/coste360/arenile da usare.
ARENILE_VERSION=latest
# Porta pubblicata sull'host.
ARENILE_PUBLISH_PORT=8080
# Credenziali PostgreSQL per deploy/docker-compose.postgres.yml.
# La password viene inserita in DATABASE_URL senza codifica: usa solo caratteri
# URL-safe, ad esempio generala con: openssl rand -hex 24
POSTGRES_USER=arenile
POSTGRES_PASSWORD=
POSTGRES_DB=arenile
